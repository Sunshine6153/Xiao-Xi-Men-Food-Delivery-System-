.mine-page { padding:72rpx 40rpx 160rpx; }.profile-card { display:flex; align-items:center; padding:34rpx 28rpx; color:#fff; background:linear-gradient(138deg,#1677ff,#59adff); border-radius:28rpx; box-shadow:0 12rpx 25rpx rgba(22,119,255,.18); }.profile-avatar { display:flex; align-items:center; justify-content:center; width:100rpx; height:100rpx; margin-right:22rpx; color:#1677ff; background:#fff; border:6rpx solid rgba(255,255,255,.35); border-radius:50%; font-size:40rpx; font-weight:700; }.profile-copy { flex:1; }.login-title { font-size:29rpx; font-weight:700; }.login-subtitle { margin-top:10rpx; color:#d9edff; font-size:21rpx; }.profile-arrow { font-size:42rpx; }.login-notice { display:flex; align-items:center; margin-top:18rpx; padding:22rpx 24rpx; color:#28506f; background:#eef7ff; border:1rpx solid #cfe6fa; border-radius:8rpx; }.login-notice-title { font-size:24rpx; font-weight:600; }.login-notice-copy { flex:1; margin-left:16rpx; color:#6f8495; font-size:21rpx; }.login-notice-action { color:#1677ff; font-size:22rpx; font-weight:600; }.stats-card { display:flex; justify-content:space-around; margin-top:22rpx; padding:27rpx 0; background:#fff; border-radius:24rpx; }.stats-card view { flex:1; text-align:center; border-right:1rpx solid #edf1f6; }.stats-card view:last-child { border:0; }.stat-number,.stat-label { display:block; }.stat-number { color:#17324d; font-size:34rpx; font-weight:700; }.stat-label { margin-top:8rpx; color:#8a96a3; font-size:20rpx; }.menu-card { margin-top:22rpx; padding:0 26rpx; background:#fff; border-radius:24rpx; }.menu-item { display:flex; align-items:center; height:104rpx; color:#334b62; border-bottom:1rpx solid #edf1f6; font-size:25rpx; }.menu-item:last-child { border:0; }.menu-icon { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; margin-right:18rpx; border-radius:16rpx; font-size:28rpx; }.blue-bg { color:#1677ff; background:#eaf4ff; }.green-bg { color:#21a879; background:#e8f9f1; }.orange-bg { color:#f09c3e; background:#fff4e6; }.menu-arrow { margin-left:auto; color:#a2afbb; font-size:34rpx; }.mine-footer { margin-top:62rpx; color:#9aa6b2; font-size:22rpx; line-height:34rpx; text-align:center; }.mine-footer text { color:#c0c8cf; font-size:20rpx; }
