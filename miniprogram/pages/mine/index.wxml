<view class="page-shell mine-page"><view class="profile-card" bindtap="login"><image wx:if="{{user && user.avatarUrl}}" class="profile-avatar-image" src="{{user.avatarUrl}}" mode="aspectFill" /><view wx:else class="profile-avatar">{{user ? '小' : '未'}}</view><view class="profile-copy"><view class="login-title">{{user ? user.name : '登录后开启小西门'}}</view><view class="login-subtitle">{{user ? user.phone : '微信一键登录，点餐和帮带更方便'}}</view></view><text wx:if="{{user}}" class="logout-inline" catchtap="logout">退出登录</text><text wx:else class="profile-arrow">›</text></view><view wx:if="{{!user}}" class="login-notice" bindtap="login"><text class="login-notice-title">当前未登录</text><text class="login-notice-copy">登录后才能提交订单、参与帮带</text><text class="login-notice-action">去登录 ›</text></view><view class="stats-card"><view><text class="stat-number">{{orderCount}}</text><text class="stat-label">我的订单</text></view><view><text class="stat-number">{{carryCount}}</text><text class="stat-label">帮带次数</text></view><view><text class="stat-number">{{addressCount}}</text><text class="stat-label">收货地址</text></view></view><view class="menu-card"><view class="menu-item" bindtap="goAddress"><text class="menu-icon blue-bg">⌂</text><text>地址管理</text><text class="menu-arrow">›</text></view><view class="menu-item" bindtap="goDelivery"><text class="menu-icon green-bg">↗</text><text>帮带记录</text><text class="menu-arrow">›</text></view><view class="menu-item"><text class="menu-icon orange-bg">?</text><text>关于小西门</text><text class="menu-arrow">›</text></view></view><view class="mine-footer">小西门校园美食配送<br/><text>让每一份顺路，都有意义</text></view><view class="tabbar safe-bottom"><view class="tabbar-item" bindtap="goHome"><text class="tab-icon">⌂</text><text>点餐</text></view><view class="tabbar-item" bindtap="goDelivery"><text class="tab-icon">⇢</text><text>帮带</text></view><view class="tabbar-item" bindtap="goOrders"><text class="tab-icon">▤</text><text>订单</text></view><view class="tabbar-item active"><text class="tab-icon">◯</text><text>我的</text></view></view></view>
