.detail-page { padding-bottom:80rpx; }.status-hero { padding:88rpx 40rpx 55rpx; color:#fff; background:linear-gradient(138deg,#1677ff,#55aaff); text-align:center; }.status-icon { display:flex; align-items:center; justify-content:center; width:86rpx; height:86rpx; margin:0 auto 20rpx; color:#1677ff; background:#fff; border-radius:50%; font-size:45rpx; font-weight:700; }.status-title { font-size:38rpx; font-weight:700; }.status-copy { margin-top:12rpx; color:#dceeff; font-size:22rpx; }.timeline-card,.detail-card { margin:24rpx 40rpx 0; padding:28rpx; background:#fff; border-radius:24rpx; }.timeline-step { display:flex; min-height:112rpx; }.step-line { position:relative; width:36rpx; }.step-line::after { position:absolute; top:30rpx; bottom:-4rpx; left:14rpx; width:2rpx; background:#e6edf4; content:''; }.timeline-step:last-child .step-line::after { display:none; }.step-dot { position:absolute; top:6rpx; left:7rpx; z-index:1; width:16rpx; height:16rpx; background:#d5e0ea; border:5rpx solid #fff; border-radius:50%; box-shadow:0 0 0 2rpx #d5e0ea; }.step-content { padding-left:18rpx; }.step-title,.step-copy { display:block; }.step-title { color:#708395; font-size:25rpx; }.step-copy { margin-top:7rpx; color:#a5b0ba; font-size:21rpx; }.step-done .step-dot { background:#21b573; box-shadow:0 0 0 2rpx #bcebd7; }.step-done .step-title { color:#334b62; font-weight:600; }.step-current .step-dot { background:#1677ff; box-shadow:0 0 0 2rpx #aed3ff; }.step-current .step-title { color:#1677ff; font-weight:700; }.detail-card-title { padding-bottom:20rpx; color:#17324d; border-bottom:1rpx solid #edf1f6; font-size:27rpx; font-weight:600; }.detail-row { display:flex; justify-content:space-between; padding-top:20rpx; color:#8a96a3; font-size:22rpx; }.detail-row text:last-child { max-width:410rpx; color:#4a6072; text-align:right; }.detail-summary { padding:20rpx 0 4rpx; color:#4a6072; font-size:24rpx; line-height:36rpx; }.cancel-button { margin:26rpx 40rpx; color:#e36b63; background:#fff; b