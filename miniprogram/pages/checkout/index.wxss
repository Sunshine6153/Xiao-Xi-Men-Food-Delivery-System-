.checkout-page { padding:72rpx 40rpx 70rpx; }.eyebrow { color:#1677ff; font-size:20rpx; letter-spacing:2rpx; }.inner-title { margin-top:16rpx; color:#17324d; font-size:52rpx; font-weight:700; }.address-card,.form-card,.items-card,.pay-summary { margin-top:30rpx; padding:26rpx; background:#fff; border-radius:24rpx; }.address-card { display:flex; align-items:center; }.address-icon { display:flex; align-items:center; justify-content:center; width:62rpx; height:62rpx; margin-right:18rpx; color:#1677ff; background:#eaf4ff; border-radius:18rpx; font-size:34rpx; }.address-copy { flex:1; }.address-label,.address-value,.address-hint { display:block; }.address-label { color:#9aa6b2; font-size:21rpx; }.address-value { margin-top:8rpx; color:#17324d; font-size:28rpx; font-weight:600; }.address-hint { margin-top:7rpx; color:#9aa6b2; font-size:19rpx; }.address-arrow { color:#a2afbb; font-size:34rpx; }.form-row { display:flex; align-items:center; min-height:92rpx; border-bottom:1rpx solid #edf1f6; }.form-row.last { border-bottom:0; }.form-label { width:150rpx; color:#596f83; font-size:24rpx; }.form-row input { flex:1; color:#334b62; font-size:24rpx; text-align:right; }.placeholder { color:#b1bac3; }.fee-input { display:flex; flex:1; justify-content:flex-end; align-items:center; color:#1677ff; font-size:26rpx; font-weight:600; }.fee-input input { flex:none; width:150rpx; margin-left:6rpx; }.card-title { padding-bottom:20rpx; color:#17324d; border-bottom:1rpx solid #edf1f6; font-size:27rpx; font-weight:600; }.card-title text { float:right; color:#9aa6b2; font-size:21rpx; font-weight:400; }.checkout-item { display:flex; justify-content:space-between; padding-top:20rpx; color:#6d7e8e; font-size:23rpx; }.checkout-item text:last-child { color:#334b62; }.pay-summary { padding:10rpx 28rpx 25rpx; }.pay-summary view { display:flex; justify-content:space-between; margin-top:22rpx; color:#7b8792; font-size:23rpx; }.pay-total { padding-top:22rpx; color:#17324d !important; border-top:1rpx solid #edf1f6; font-size:28rpx !important; font-weight:600; }.pay-total text:last-child { color:#1677ff; font-size:36rpx; }.pay-button { width:100%; margin-top:28rpx; color:#fff; background:#1677ff; border-radius:18rpx; font-size:28rpx; line-height:88rpx; }.login-mask { position:fixed; inset:0; z-index:20; display:flex; align-items:flex-end; background:rgba(13,31,52,.48); }.login-panel { width:100%; padding:45rpx 50rpx 55rpx; background:#fff; border-radius:34rpx 34rpx 0 0; text-align:center; }.login-illustration { display:flex; align-items:center; justify-content:center; width:90rpx; height:90rpx; margin:0 auto 20rpx; color:#1677ff; background:#eaf4ff; border-radius:28rpx; font-size:40rpx; font-weight:700; }.login-title { color:#17324d; font-size:34rpx; font-weight:700; }.login-copy { margin-top:13rpx; color:#8a96a3; font-size:23rpx; line-height:36rpx; }.wechat-button { margin-top:30rpx; color:#fff; background:#21b573; border-radius:18rpx; font-size:27rpx; line-height:82rpx; }.later-button { margin-top:22rpx; color:#9aa6b2; font-size:23rpx; }
