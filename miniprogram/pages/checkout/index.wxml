<navigation-bar title="确认订单" back="{{true}}" color="#17324d" background="#ffffff"></navigation-bar>
<view class="page-shell checkout-page"><view class="checkout-heading"><view class="eyebrow blue">READY TO ORDER</view><view class="inner-title">确认订单</view></view><view class="address-card" bindtap="editAddress"><view class="address-icon">⌖</view><view class="address-copy"><text class="address-label">配送到</text><text class="address-value">{{address || '填写校园内配送地址'}}</text><text class="address-hint">例如：第五宿舍 301、八舍楼下</text></view><text class="address-arrow">›</text></view><view class="form-card"><view class="form-row"><text class="form-label">配送要求</text><input value="{{requirement}}" placeholder="例如：送到宿舍楼下" placeholder-class="placeholder" bindinput="onRequirement" /></view><view class="form-row"><text class="form-label">帮带费用</text><view class="fee-input"><text>¥</text><input type="digit" value="{{fee}}" placeholder="自愿填写" placeholder-class="placeholder" bindinput="onFee" /></view></view><view class="form-row last"><text class="form-label">订单备注</text><input value="{{remark}}" placeholder="口味、餐具等要求" placeholder-class="placeholder" bindinput="onRemark" /></view></view><view class="items-card"><view class="card-title">餐品明细 <text>{{cart.length}} 项</text></view><view wx:for="{{cart}}" wx:key="key" class="checkout-item"><text>{{item.name}} ×{{item.number}}</text><text>¥{{item.lineTotal}}</text></view></view><view class="pay-summary"><view><text>商品合计</text><text>¥{{subtotal}}</text></view><view><text>帮带费</text><text>¥{{fee || '0.00'}}</text></view><view class="pay-total"><text>应付合计</text><text>¥{{total}}</text></view></view><button class="pay-button" disabled="{{submitting}}" bindtap="submitOrder">{{submitting ? '处理中...' : (pendingOrder ? '重新支付 ¥' + total : '确认支付 ¥' + total)}}</button><view wx:if="{{showLogin}}" class="login-mask" catchtap="closeLogin"><view class="login-panel" catchtap="stopPropagation"><view class="login-illustration">小</view><view class="login-title">登录小西门</view><view class="login-copy">登录后才能提交订单<br/>也可以参与顺路帮带</view><button class="wechat-button" bindtap="wechatLogin">微信一键登录</button><view class="later-button" bindtap="closeLogin">暂时不要</view></view></view></view>
