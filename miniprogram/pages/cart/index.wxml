<navigation-bar title="购物车" back="{{true}}" color="#17324d" background="#ffffff"></navigation-bar>
<view class="page-shell cart-page"><view class="cart-heading"><view><view class="eyebrow blue">YOUR SELECTION</view><view class="inner-title">购物车</view></view><text wx:if="{{cartCount}}" class="clear-button" bindtap="clearCart">清空</text></view><block wx:if="{{groups.length}}"><block wx:for="{{groups}}" wx:key="merchant"><view class="merchant-group"><view class="merchant-title"><text class="store-dot"></text><text>{{item.merchant}}</text><text class="merchant-location">{{item.location}}</text><text class="merchant-hint">{{item.items.length}} 项</text></view><view wx:for="{{item.items}}" wx:key="key" class="cart-item"><image src="{{item.image}}" mode="aspectFill" /><view class="cart-item-info"><text class="cart-item-name">{{item.name}}</text><text class="cart-item-flavor">{{item.flavor}}</text><text class="cart-item-price">¥{{item.price}}</text></view><view class="quantity"><text class="quantity-button" data-key="{{item.key}}" data-change="-1" bindtap="changeQuantity">−</text><text>{{item.number}}</text><text class="quantity-button plus" data-key="{{item.key}}" data-change="1" bindtap="changeQuantity">+</text></view></view></view></block><view class="summary-card"><view><text>商品合计 · {{cartCount}} 件</text><text>¥{{subtotal}}</text></view><view><text>帮带费</text><text class="muted">结算时填写</text></view><view class="summary-total"><text>预计合计</text><text>¥{{subtotal}}</text></view></view><button class="checkout-button" bindtap="goCheckout">去确认订单 <text>›</text></button></block><view wx:else class="empty-state"><text class="empty-icon">🛒</text><text class="empty-title">购物车还是空的</text><text class="empty-copy">去点餐页挑一点喜欢的吧</text><button class="primary-button" bindtap="goHome">去逛逛</button></view></view>
