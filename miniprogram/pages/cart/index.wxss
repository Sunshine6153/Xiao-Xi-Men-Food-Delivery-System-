.cart-page { padding:72rpx 40rpx 80rpx; }.cart-heading { display:flex; align-items:flex-start; justify-content:space-between; }.eyebrow { font-size:20rpx; letter-spacing:2rpx; }.blue { color:#1677ff; }.inner-title { margin-top:16rpx; color:#17324d; font-size:52rpx; font-weight:700; }.clear-button { margin-top:28rpx; color:#8a96a3; font-size:23rpx; }.merchant-group,.summary-card { margin-top:34rpx; padding:24rpx; background:#fff; border-radius:24rpx; }.merchant-title { display:flex; align-items:center; padding-bottom:20rpx; color:#17324d; border-bottom:1rpx solid #edf1f6; font-size:26rpx; font-weight:600; }.store-dot { width:14rpx; height:14rpx; margin-right:12rpx; background:#1677ff; border-radius:50%; }.merchant-hint { margin-left:auto; color:#9aa6b2; font-size:20rpx; font-weight:400; }.cart-item { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #f0f3f6; }.cart-item:last-child { padding-bottom:0; border:0; }.cart-item image { width:124rpx; height:124rpx; margin-right:18rpx; border-radius:16rpx; background:#eaf4ff; }.cart-item-info { flex:1; min-width:0; }.cart-item-name,.cart-item-flavor,.cart-item-price { display:block; }.cart-item-name { overflow:hidden; color:#334b62; font-size:26rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.cart-item-flavor { margin-top:8rpx; color:#9aa6b2; font-size:20rpx; }.cart-item-price { margin-top:12rpx; color:#1677ff; font-size:26rpx; font-weight:700; }.quantity { display:flex; align-items:center; gap:18rpx; color:#334b62; font-size:25rpx; }.quantity-button { display:flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; color:#6d8093; background:#f1f5f8; border-radius:50%; font-size:30rpx; }.quantity-button.plus { color:#fff; background:#1677ff; }.summary-card { padding:24rpx 28rpx; }.summary-card view { display:flex; justify-content:space-between; margin-bottom:20rpx; color:#7b8792; font-size:23rpx; }.summary-card .summary-total { margin:24rpx 0 0; padding-top:22rpx; color:#17324d; border-top:1rpx solid #edf1f6; font-size:28rpx; font-weight:600; }.summary-total text:last-child { color:#1677ff; font-size:34rpx; }.muted { color:#a6b0ba; }.checkout-button { width:100%; margin-top:26rpx; color:#fff; background:#1677ff; border-radius:18rpx; font-size:28rpx; line-height:88rpx; }.checkout-button text { margin-left:10rpx; font-size:36rpx; }.empty-state { display:flex; align-items:center; flex-direction:column; padding-top:210rpx; }.empty-icon { font-size:76rpx; opacity:.8; }.empty-title { margin-top:25rpx; color:#17324d; font-size:30rpx; font-weight:700; }.empty-copy { margin-top:10rpx; color:#9aa6b2; font-size:23rpx; }.primary-button { margin-top:34rpx; padding:0 54rpx; color:#fff; background:#1677ff; border-radius:18rpx; font-size:26rpx; line-height:78rpx; }
