.address-page { padding:72rpx 40rpx 80rpx; }.address-heading { display:flex; align-items:flex-start; justify-content:space-between; }.eyebrow { color:#1677ff; font-size:20rpx; letter-spacing:2rpx; }.inner-title { margin-top:16rpx; color:#17324d; font-size:52rpx; font-weight:700; }.address-count { margin-top:28rpx; color:#9aa6b2; font-size:22rpx; }.address-list { margin-top:32rpx; }.address-card { margin-bottom:20rpx; padding:26rpx; background:#fff; border-radius:24rpx; }.address-card-main { display:flex; align-items:center; }.address-pin { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; margin-right:18rpx; color:#1677ff; background:#eaf4ff; border-radius:17rpx; font-size:32rpx; }.address-text { color:#17324d; font-size:29rpx; font-weight:600; }.address-time { margin-top:8rpx; color:#a0aab5; font-size:20rpx; }.default-tag { margin-left:auto; padding:7rpx 12rpx; color:#1677ff; background:#edf6ff; border-radius:9rpx; font-size:19rpx; }.address-actions { display:flex; justify-content:flex-end; gap:28rpx; margin-top:22rpx; padding-top:18rpx; color:#7d91a4; border-top:1rpx solid #edf1f6; font-size:21rpx; }.address-actions text:last-child { color:#de746b; }.empty-address { display:flex; align-items:center; flex-direction:column; padding-top:180rpx; color:#9aa6b2; font-size:24rpx; }.empty-pin { margin-bottom:20rpx; color:#c8d5e0; font-size:90rpx; }.add-address { width:100%; margin-top:30rpx; color:#1677ff; background:#fff; border:2rpx solid #a8d0ff; border-radius:18rpx; font-size:27rpx; line-height:84rpx; }
.address-hint { margin-top:24rpx; color:#7d91a4; font-size:23rpx; }
.address-form-mask { position:fixed; inset:0; z-index:20; display:flex; align-items:flex-end; background:rgba(13,31,52,.48); }
.address-form { width:100%; padding:36rpx 40rpx 60rpx; background:#fff; border-radius:24rpx 24rpx 0 0; }
.address-form-title { margin-bottom:18rpx; color:#17324d; font-size:32rpx; font-weight:600; }
.address-form-row { display:flex; align-items:center; min-height:94rpx; border-bottom:1rpx solid #edf1f6; color:#596f83; font-size:25rpx; }
.address-form-row text { width:150rpx; flex:none; }
.address-form-row input { flex:1; color:#17324d; font-size:25rpx; }
.address-form-actions { display:flex; gap:20rpx; margin-top:34rpx; }
.address-form-actions button { flex:1; margin:0; color:#596f83; background:#f1f4f7; font-size:26rpx; }
.address-form-actions .address-save { color:#fff; background:#1677ff; }
