.inner-page { padding: 72rpx 40rpx 160rpx; }.inner-header { display:flex; align-items:flex-start; justify-content:space-between; }.eyebrow { font-size:20rpx; letter-spacing:2rpx; }.blue { color:#1677ff; }.inner-title { margin-top:16rpx; color:#17324d; font-size:52rpx; font-weight:700; }.inner-subtitle { margin-top:10rpx; color:#8a96a3; font-size:24rpx; }.header-badge { width:96rpx; height:96rpx; padding-top:19rpx; color:#1677ff; background:#eaf4ff; border-radius:50%; font-size:22rpx; line-height:30rpx; text-align:center; }.tip-card { display:flex; align-items:center; margin:34rpx 0 28rpx; padding:24rpx; background:#eaf4ff; border-radius:22rpx; }.tip-icon { display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; margin-right:18rpx; color:#1677ff; background:#fff; border-radius:18rpx; font-size:32rpx; }.tip-title,.tip-text { display:block; }.tip-title { color:#315b83; font-size:25rpx; font-weight:600; }.tip-text { margin-top:5rpx; color:#6f90ad; font-size:21rpx; }.delivery-card { margin-bottom:22rpx; padding:26rpx; background:#fff; border-radius:24rpx; box-shadow:0 8rpx 22rpx rgba(33,68,105,.04); }.delivery-top { display:flex; align-items:flex-start; justify-content:space-between; }.delivery-label { display:block; color:#9aa6b2; font-size:21rpx; }.delivery-address { display:block; margin-top:6rpx; color:#17324d; font-size:32rpx; font-weight:700; }.fee { padding:10rpx 14rpx; color:#1677ff; background:#edf6ff; border-radius:12rpx; font-size:24rpx; font-weight:600; }.food-summary { margin-top:22rpx; padding:18rpx; overflow:hidden; color:#586b7e; background:#f7f9fb; border-radius:14rpx; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }.delivery-meta { display:flex; align-items:center; margin-top:20rpx; color:#a0aab5; font-size:20rpx; }.delivery-meta text:nth-child(2) { margin-left:14rpx; }.outline-button { margin:0 0 0 auto; padding:0 18rpx; color:#1677ff; background:#fff; border:2rpx solid #a8d0ff; border-radius:14rpx; font-size:21rpx; line-height:58rpx; }
