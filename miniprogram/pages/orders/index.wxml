<view class="page-shell inner-page"><view class="orders-heading"><view><view class="eyebrow blue">ORDER CENTER</view><view class="inner-title">订单</view></view><view class="order-count">{{total}}<br/><text>全部订单</text></view></view><view class="switcher"><view class="switch-item {{activeTab === 'buy' ? 'switch-active' : ''}}" data-tab="buy" bindtap="switchTab">我买的</view><view class="switch-item {{activeTab === 'carry' ? 'switch-active' : ''}}" data-tab="carry" bindtap="switchTab">我帮带的</view></view><view wx:if="{{loading}}" class="state-box"><text class="state-icon">◌</text><text>正在加载订单...</text></view><view wx:elif="{{errorMessage}}" class="state-box"><text class="state-icon">!</text><text class="state-title">订单加载失败</text><text class="state-copy">{{errorMessage}}</text><button class="state-button" bindtap="loadOrders">重新加载</button><button class="state-button" bindtap="login">微信登录</button></view><block wx:elif="{{orders.length}}"><view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="openDetail"><view class="order-top"><text class="order-time">{{item.createdAt || item.time}}</text><text class="order-status">{{item.status}}</text></view><view class="order-summary">{{item.summary}}</view><view class="order-bottom"><text class="order-address">送到 {{item.address}}</text><view><text class="order-total-label">合计 </text><text class="order-total">¥{{item.total}}</text></view></view></view></block><view wx:else class="state-box"><text class="state-icon">▤</text><text class="state-title">还没有订单</text><text class="state-copy">去点餐，第一单马上开始</text><button class="state-button" bindtap="goHome">去点餐</button></view><view wx:if="{{orders.length}}" class="list-footer"><text wx:if="{{moreError}}">{{moreError}}</text><button wx:if="{{hasMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在加载...' : '加载更多'}}</button><text wx:else>已经到底了</text></view><view class="tabbar safe-bottom"><view class="tabbar-item" bindtap="goHome"><text class="tab-icon">⌂</text><text>点餐</text></view><view class="tabbar-item" bindtap="goDelivery"><text class="tab-icon">⇢</text><text>帮带</text></view><view class="tabbar-item active"><text class="tab-icon">▤</text><text>订单</text></view><view class="tabbar-item" bindtap="goMine"><text class="tab-icon">◯</text><text>我的</text></view></view></view>
