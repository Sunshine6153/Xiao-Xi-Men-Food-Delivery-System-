.inner-page { padding:72rpx 40rpx 160rpx; }.orders-heading { display:flex; justify-content:space-between; align-items:flex-start; }.eyebrow { font-size:20rpx; letter-spacing:2rpx; }.blue { color:#1677ff; }.inner-title { margin-top:16rpx; color:#17324d; font-size:52rpx; font-weight:700; }.order-count { width:92rpx; height:92rpx; padding-top:15rpx; color:#1677ff; background:#eaf4ff; border-radius:50%; font-size:30rpx; font-weight:700; text-align:center; line-height:32rpx; }.order-count text { color:#6d9bc2; font-size:17rpx; font-weight:400; }.switcher { display:flex; margin:38rpx 0 24rpx; padding:8rpx; background:#eaf4ff; border-radius:18rpx; }.switch-item { flex:1; padding:18rpx 0; color:#7b9abb; border-radius:14rpx; font-size:25rpx; text-align:center; }.switch-active { color:#1677ff; background:#fff; font-weight:600; box-shadow:0 5rpx 14rpx rgba(22,119,255,.1); }.order-card { margin-bottom:22rpx; padding:26rpx; background:#fff; border-radius:24rpx; box-shadow:0 8rpx 22rpx rgba(33,68,105,.04); }.order-top,.order-bottom { display:flex; align-items:center; justify-content:space-between; }.order-time { color:#9aa6b2; font-size:21rpx; }.order-status { color:#1677ff; font-size:23rpx; }.order-summary { margin:22rpx 0; padding-bottom:22rpx; color:#334b62; border-bottom:1rpx solid #edf1f6; font-size:26rpx; line-height:38rpx; }.order-address { max-width:360rpx; overflow:hidden; color:#8a96a3; font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }.order-total-label { color:#8a96a3; font-size:20rpx; }.order-total { color:#1677ff; font-size:31rpx; font-weight:700; }
