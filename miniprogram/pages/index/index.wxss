.hero { padding: 72rpx 40rpx 30rpx; color: #17324d; background: #fff; border-bottom: 1rpx solid #e7edf3; }
.hero-title { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }.hero-subtitle { margin-top: 12rpx; color: #7e8c99; font-size: 24rpx; }.search-box { display:flex; align-items:center; height:78rpx; margin-top:30rpx; padding:0 22rpx; color:#53718e; background:#f5f7f9; border:1rpx solid #e5ebf0; border-radius:10rpx; }.search-icon { margin-right:14rpx; font-size:38rpx; }.search-box input { flex:1; font-size:25rpx; }.search-placeholder { color:#a5b0ba; }
.notice-bar { display:flex; align-items:center; margin:24rpx 40rpx 8rpx; padding:15rpx 0; color:#52718f; font-size:22rpx; }.notice-dot { width:10rpx; height:10rpx; margin-right:12rpx; background:#21b573; border-radius:50%; }.notice-arrow { margin-left:auto; color:#9aa7b2; font-size:30rpx; }.category-scroll { white-space:nowrap; }.category-row { display:flex; padding:16rpx 40rpx 12rpx; }.category { display:inline-flex; flex-direction:column; align-items:center; justify-content:center; min-width:96rpx; height:94rpx; margin-right:12rpx; color:#7d8995; font-size:22rpx; background:#fff; border:1rpx solid #e4eaf0; border-radius:10rpx; }.category-active { color:#1677ff; border-color:#1677ff; background:#f2f7ff; font-weight:600; }.category-icon { margin-bottom:5rpx; font-size:30rpx; }.section-heading { display:flex; align-items:baseline; justify-content:space-between; margin:22rpx 40rpx 16rpx; }.section-title { color:#17324d; font-size:32rpx; font-weight:700; }.section-more { color:#9aa6b2; font-size:21rpx; }.dish-list { padding:0 40rpx; }.dish-card { display:flex; min-height:228rpx; margin-bottom:16rpx; padding:14rpx; background:#fff; border:1rpx solid #e9eef3; border-radius:12rpx; }.dish-image { width:190rpx; height:198rpx; flex-shrink:0; border-radius:8rpx; background:#edf2f6; }.dish-info { display:flex; flex:1; flex-direction:column; min-width:0; padding:4rpx 0 0 18rpx; }.dish-name-row { display:flex; align-items:center; }.dish-name { max-width:225rpx; overflow:hidden; color:#17324d; font-size:29rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.dish-tag { margin-left:8rpx; padding:4rpx 8rpx; color:#1677ff; background:#eef5ff; font-size:17rpx; }.dish-desc { height:54rpx; margin-top:9rpx; overflow:hidden; color:#8a96a3; font-size:21rpx; line-height:27rpx; }.merchant-line { overflow:hidden; color:#5e87ae; font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }.merchant-location { color:#9caebb; }.dish-bottom { display:flex; align-items:center; justify-content:space-between; margin-top:auto; }.price-symbol { color:#1677ff; font-size:21rpx; font-weight:700; }.price { color:#1677ff; font-size:34rpx; font-weight:700; }.sold { color:#a6b0bb; font-size:18rpx; }.add-button { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; color:#fff; background:#1677ff; border-radius:50%; font-size:36rpx; }.cart-bar { position:fixed; right:40rpx; bottom:158rpx; left:40rpx; z-index:10; display:flex; align-items:center; height:88rpx; padding:0 12rpx; color:#fff; background:#17324d; border-radius:12rpx; box-shadow:0 8rpx 20rpx rgba(23,50,77,.16); }.cart-bubble { position:relative; display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; background:#1677ff; border-radius:8rpx; }.cart-icon { font-size:31rpx; }.cart-count { position:absolute; top:-10rpx; right:-10rpx; min-width:30rpx; height:30rpx; padding:0 7rpx; color:#1677ff; background:#fff; border-radius:15rpx; font-size:18rpx; line-height:30rpx; text-align:center; }.cart-summary { flex:1; padding-left:18rpx; }.cart-label { display:block; color:#b7c5d1; font-size:20rpx; }.cart-total { font-size:28rpx; font-weight:700; }.cart-action { padding:14rpx; font-size:24rpx; }.cart-action text { padding-left:6rpx; font-size:30rpx; }
.modal-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:30; display:flex; align-items:flex-end; justify-content:center; background:rgba(16,34,52,.46); }.dish-modal { position:relative; width:100%; max-height:86vh; overflow:hidden; background:#fff; border-radius:16rpx 16rpx 0 0; }.modal-image { width:100%; height:300rpx; background:#edf2f6; }.modal-close { position:absolute; top:20rpx; right:24rpx; display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; color:#17324d; background:#fff; border-radius:50%; font-size:34rpx; }.modal-content { padding:24rpx 36rpx 38rpx; }.modal-title-row,.modal-bottom { display:flex; align-items:center; justify-content:space-between; }.modal-title { color:#17324d; font-size:34rpx; font-weight:700; }.modal-price { color:#1677ff; font-size:31rpx; font-weight:700; }.modal-merchant { margin-top:8rpx; color:#5e87ae; font-size:21rpx; }.modal-desc { margin-top:16rpx; color:#7e8995; font-size:23rpx; line-height:34rpx; }.flavor-title { margin-top:22rpx; color:#17324d; font-size:24rpx; font-weight:600; }.flavors { display:flex; flex-wrap:wrap; margin-top:12rpx; }.flavor { margin:0 10rpx 10rpx 0; padding:10rpx 20rpx; color:#718091; background:#f4f7fa; border:1rpx solid #e1e8ee; border-radius:8rpx; font-size:21rpx; }.flavor-active { color:#1677ff; background:#f0f6ff; border-color:#1677ff; }.modal-bottom { margin-top:20rpx; }.modal-label { display:block; color:#8a96a3; font-size:19rpx; }.primary-button { margin:0; padding:0 42rpx; color:#fff; background:#1677ff; border-radius:8rpx; font-size:25rpx; line-height:74rpx; }
.menu-layout { display:flex; align-items:stretch; min-height:calc(100vh - 360rpx); margin-top:8rpx; border-top:1rpx solid #edf1f4; }.category-side { flex:0 0 148rpx; width:148rpx; height:calc(100vh - 360rpx); background:#f7f9fb; border-right:1rpx solid #edf1f4; }.category-item { display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:0 12rpx; color:#718091; border-left:6rpx solid transparent; font-size:23rpx; text-align:center; }.category-item-active { color:#1677ff; background:#fff; border-left-color:#1677ff; font-weight:600; }.dish-content { flex:1; min-width:0; background:#fff; }.dish-content .section-heading { margin:22rpx 24rpx 12rpx; }.dish-content .dish-list { padding:0 24rpx; }.dish-content .dish-card { min-height:210rpx; margin-bottom:12rpx; padding:12rpx 0; border-width:0; border-bottom:1rpx solid #edf1f4; border-radius:0; }.dish-content .dish-image { width:154rpx; height:166rpx; border-radius:6rpx; }.dish-content .dish-info { padding-left:14rpx; }.dish-content .dish-name { max-width:190rpx; font-size:27rpx; }.dish-content .dish-desc { height:48rpx; margin-top:6rpx; font-size:20rpx; line-height:24rpx; }.dish-action { min-width:76rpx; height:48rpx; margin:0; padding:0 12rpx; border:0; font-size:21rpx; line-height:48rpx; }.dish-action::after { border:0; }.spec-button { color:#1677ff; background:#eef5ff; border:1rpx solid #b9d5f2; border-radius:6rpx; }.add-button-text { color:#fff; background:#1677ff; border-radius:6rpx; }.home-page .category-scroll { display:none; }
.home-page .hero { position:sticky; top:0; z-index:8; padding:14rpx 40rpx; background:#fff; border-bottom:1rpx solid #edf1f4; }.home-page .search-box { margin-top:0; height:70rpx; }.home-page .notice-bar { height:48rpx; margin:4rpx 24rpx 0; padding:4rpx 0; }.home-page .menu-layout { margin-top:4rpx; }
.menu-state { display:flex; align-items:center; justify-content:center; min-height:360rpx; flex-direction:column; padding:40rpx 24rpx; color:#8a96a3; text-align:center; }.menu-state-title { color:#52687d; font-size:28rpx; }.menu-state-desc { margin-top:12rpx; color:#9aa6b2; font-size:22rpx; }.menu-state-button { min-width:180rpx; height:64rpx; margin-top:24rpx; padding:0 24rpx; color:#fff; background:#1677ff; border:0; border-radius:6rpx; font-size:23rpx; line-height:64rpx; }.menu-state-button::after { border:0; }
