page {
  background: #f6f8fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}
view, text, scroll-view, button, image { box-sizing: border-box; }
button::after { border: 0; }
.page-shell { min-height: 100vh; padding-bottom: 148rpx; }
.tabbar { position: fixed; left: 24rpx; right: 24rpx; bottom: 24rpx; z-index: 20; height: 112rpx; padding: 12rpx 10rpx; display: flex; align-items: center; background: rgba(255,255,255,.96); border: 1rpx solid #edf1f6; border-radius: 32rpx; box-shadow: 0 12rpx 40rpx rgba(28,72,125,.14); }
.tabbar-item { flex: 1; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9aa6b2; font-size: 22rpx; }
.tabbar-item.active { color: #1677ff; font-weight: 600; }
.tab-icon { font-size: 38rpx; line-height: 44rpx; margin-bottom: 2rpx; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.card { background: #fff; border-radius: 24rpx; }

/* 首页双层滚动布局：外层纵向、分类栏横向。 */
.main-scroll { display: block; width: 100%; height: 100vh; }
.category-scroll { display: block; width: 100%; height: 122rpx; white-space: nowrap; }
.category-row { display: inline-flex; min-width: 100%; white-space: nowrap; }
.category { flex: 0 0 auto; }

/* 统一简洁的浮动结算栏，避免大色块抢占内容。 */
.cart-bar { right: 32rpx; left: 32rpx; bottom: 148rpx; height: 82rpx; padding: 0 10rpx; background: #ffffff; border: 1rpx solid #e3eaf0; border-radius: 14rpx; box-shadow: 0 8rpx 24rpx rgba(35, 65, 92, .12); }
.cart-bubble { width: 62rpx; height: 62rpx; border-radius: 10rpx; }
.cart-summary { padding-left: 16rpx; color: #17324d; }
.cart-label { color: #8493a1; }
.cart-total { color: #1677ff; }
.cart-action { color: #1677ff; font-weight: 600; }
.weui-navigation-bar { background: #fff; }

/* 分类数量较少时均分一整行，数量变多时仍可横向滚动。 */
.category-row { display: flex !important; width: calc(100vw - 80rpx) !important; min-width: calc(100vw - 80rpx) !important; }
.category { flex: 1 1 0 !important; width: 0 !important; min-width: 0 !important; margin-right: 8rpx !important; }
.category:last-child { margin-right: 0 !important; }

/* 退出登录作为个人信息卡片下方的次要操作。 */
.logout-row { margin: 14rpx 8rpx 0; padding: 12rpx 8rpx 0; color: #8a96a3; border-top: 1rpx solid #edf1f6; font-size: 22rpx; text-align: right; }
.logout-inline { flex-shrink: 0; margin-left: 14rpx; padding: 10rpx 0 10rpx 12rpx; color: #e8f2ff; border-left: 1rpx solid rgba(255,255,255,.42); font-size: 21rpx; }

/* 第一阶段：收敛视觉基础，减少模板化装饰。 */
.page-shell { background: #f7f8fa; }
.eyebrow { display: none !important; }
.inner-title { margin-top: 0 !important; }
.tabbar { border-radius: 10rpx !important; box-shadow: none !important; }
.card, .merchant-group, .summary-card, .tip-card, .delivery-card, .order-card,
.address-card, .form-card, .items-card, .pay-summary, .menu-card, .stats-card,
.switcher, .login-panel { border-radius: 8rpx !important; box-shadow: none !important; }
.status-hero, .profile-card { background: #1677ff !important; border-radius: 0 !important; box-shadow: none !important; }
.status-icon, .profile-avatar, .address-icon, .tip-icon, .menu-icon { border-radius: 8rpx !important; }
.quantity-button, .add-button { border-radius: 50% !important; }
.checkout-button, .pay-button, .primary-button, .add-address, .wechat-button,
.outline-button, .cancel-button { border-radius: 6rpx !important; box-shadow: none !important; }
.category { border-radius: 6rpx !important; }
.header-badge { display: none !important; }
.cart-bar { box-shadow: none !important; }

/* 第二阶段：首页菜单重构。 */
.home-page .category-scroll { height: 86rpx !important; }
.home-page .category-row { padding: 8rpx 40rpx 0 !important; }
.home-page .category { position: relative; display: inline-flex !important; flex: 1 1 0 !important; justify-content: center; height: 70rpx !important; min-width: 0 !important; margin-right: 12rpx !important; padding: 0 8rpx !important; color: #7d8995 !important; background: transparent !important; border: 0 !important; border-bottom: 3rpx solid transparent !important; border-radius: 0 !important; font-size: 24rpx !important; }
.home-page .category:last-child { margin-right: 0 !important; }
.home-page .category-active { color: #1677ff !important; background: transparent !important; border-bottom-color: #1677ff !important; font-weight: 600; }
.home-page .category-icon { display: none !important; }
.home-page .section-heading { margin-top: 20rpx !important; margin-bottom: 0 !important; }
.home-page .dish-card { min-height: 202rpx !important; margin: 0 !important; padding: 18rpx 0 !important; background: transparent !important; border: 0 !important; border-bottom: 1rpx solid #e9edf1 !important; border-radius: 0 !important; box-shadow: none !important; }
.home-page .dish-card:last-child { border-bottom: 0 !important; }
.home-page .dish-image { width: 164rpx !important; height: 164rpx !important; border-radius: 6rpx !important; }
.home-page .dish-info { padding-left: 18rpx !important; }
.home-page .dish-name { font-size: 28rpx !important; }
.home-page .dish-desc { height: 48rpx !important; margin-top: 8rpx !important; }
.home-page .add-button { width: 46rpx !important; height: 46rpx !important; }

/* 第三阶段：统一页面操作和交互反馈。 */
button { min-height: 0; padding-left: 24rpx; padding-right: 24rpx; border: 0; font-family: inherit; }
.action-stack { margin: 26rpx 40rpx 0; }
.primary-action, .secondary-action { width: 100%; margin: 0 0 14rpx; border-radius: 6rpx !important; font-size: 26rpx; line-height: 78rpx; }
.primary-action { color: #fff; background: #1677ff; }
.secondary-action { color: #5f7180; background: #fff; border: 1rpx solid #dfe6ec; }
.secondary-action.danger, .danger { color: #d96c63; background: #fff; border-color: #f0c9c5; }
.state-box, .delivery-empty { display: flex; align-items: center; flex-direction: column; padding: 150rpx 40rpx 80rpx; color: #8a96a3; font-size: 23rpx; text-align: center; }
.state-icon, .empty-icon { color: #bdc9d3; font-size: 64rpx; line-height: 80rpx; }
.state-title, .empty-title { margin-top: 16rpx; color: #334b62; font-size: 28rpx; font-weight: 600; }
.state-copy, .empty-copy { margin-top: 8rpx; color: #9aa6b2; font-size: 22rpx; }
.state-button { margin-top: 24rpx; color: #1677ff; background: #fff; border: 1rpx solid #b8d4f0; border-radius: 6rpx !important; font-size: 24rpx; line-height: 68rpx; }
.delivery-switch { display: flex; margin: 28rpx 0 20rpx; padding: 0; border-bottom: 1rpx solid #e9edf1; background: transparent; }
.delivery-tab { flex: 1; padding: 16rpx 0; color: #8a96a3; border-bottom: 3rpx solid transparent; font-size: 24rpx; text-align: center; }
.delivery-tab-active { color: #1677ff; border-bottom-color: #1677ff; font-weight: 600; }
.mine-status { margin-left: auto; color: #1677ff; }
.detail-state { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; padding: 40rpx; color: #7b8c9b; text-align: center; }
.merchant-block { padding-top: 18rpx; }
.merchant-name { padding-bottom: 14rpx; color: #17324d; font-size: 24rpx; font-weight: 600; }
.dish-line { display: grid; grid-template-columns: minmax(0, 1fr) 56rpx 120rpx; gap: 12rpx; padding: 16rpx 0; border-top: 1rpx solid #edf1f6; color: #4a6072; font-size: 22rpx; }
.dish-line > text:last-child { text-align: right; }
.dish-name, .dish-flavor { display: block; }
.dish-name { color: #334b62; }
.dish-flavor { margin-top: 6rpx; color: #9aa6b2; font-size: 19rpx; }
.weui-navigation-bar__center { color: #17324d; }
.list-footer { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 24rpx 0 40rpx; color: #8796a5; font-size: 24rpx; }
.list-footer button, .secondary-action { border: 1rpx solid #d6e0e8; border-radius: 4rpx; background: #fff; color: #1766a6; font-size: 26rpx; }
.pickup-location { margin: 12rpx 0; color: #607487; font-size: 24rpx; }
.preparation-status { margin-bottom: 12rpx; color: #1766a6; font-size: 24rpx; }
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
